# Database Configuration (PostgreSQL / Neon)
# Important: DB_URL must begin with the JDBC prefix 'jdbc:postgresql://'
DB_URL=jdbc:postgresql://ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASS=your_database_password_here

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Demo Seed Endpoint Control (true to enable POST /api/seed in staging/testing, false in production)
SEED_ENABLED=false

# Backend CORS Allowed Origins (comma-separated origins allowed to make requests)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Application Timezone
APP_TIMEZONE=America/Bogota

# Frontend API URL (leave empty for same-origin or Vite dev proxy, or set to your Render backend URL)
VITE_API_URL=https://your-backend.onrender.com

